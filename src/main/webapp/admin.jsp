<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.guvi.fraud.model.Transaction" %><%List<Transaction> tx=(List<Transaction>)request.getAttribute("tx");%><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"><title>Admin Dashboard</title></head><body><header><nav><div><h1>Admin Dashboard</h1><p>Configuration · Detection reports · Case review</p></div><a class="btn secondary" href="<%=request.getContextPath()%>/logout">Logout</a></nav></header><main><%if("1".equals(request.getParameter("updated"))){%><p class="success">Admin action completed.</p><%}%><div class="stats"><div class="card">Total<strong><%=request.getAttribute("total")%></strong></div><div class="card">Flagged<strong><%=request.getAttribute("flagged")%></strong></div><div class="card">Reviewed<strong><%=request.getAttribute("reviewed")%></strong></div><div class="card">Training rows<strong><%=request.getAttribute("rows")%></strong></div></div><div class="layout"><section class="card"><h2>Detection settings</h2><form method="post"><input type="hidden" name="action" value="settings"><label>CHECK threshold</label><input name="check" type="number" min="1" max="99" value="<%=request.getAttribute("check")%>" required><label>REVIEW threshold</label><input name="review" type="number" min="2" max="100" value="<%=request.getAttribute("review")%>" required><button>Save thresholds</button></form><hr><h2>Algorithm management</h2><p class="muted">Retrains Weka RandomForest on the bundled synthetic data. This is not a real-world performance evaluation.</p><form method="post"><input type="hidden" name="action" value="retrain"><button class="secondary">Retrain demo model</button></form></section><section class="card"><h2>Flagged cases</h2><div class="tablewrap"><table><tr><th>ID</th><th>Customer</th><th>Amount</th><th>Risk</th><th>Decision</th><th>Reason</th><th>Review</th></tr><%for(Transaction t:tx){%><tr><td>#<%=t.id%></td><td><%=esc(t.customerId)%></td><td>₹<%=t.amount%></td><td><%=t.riskScore%></td><td><span class="pill <%=t.decision%>"><%=t.decision%></span></td><td><%=esc(t.explanation)%></td><td><%if(!t.reviewed){%><form method="post"><input type="hidden" name="action" value="review"><input type="hidden" name="id" value="<%=t.id%>"><input name="note" placeholder="Review note"><button>Mark reviewed</button></form><%}else{%><span class="pill APPROVED">Reviewed</span><%=esc(t.reviewNote)%><%}%></td></tr><%}%></table></div></section></div></main></body></html><%!private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>