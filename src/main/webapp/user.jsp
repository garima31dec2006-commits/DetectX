<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.guvi.fraud.model.Transaction" %><%List<Transaction> tx=(List<Transaction>)request.getAttribute("tx");%><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"><title>User Dashboard</title></head><body><header><nav><div><h1>User Dashboard</h1><p>Submit transactions and review alerts</p></div><a class="btn secondary" href="<%=request.getContextPath()%>/logout">Logout</a></nav></header><main><%if("1".equals(request.getParameter("saved"))){%><p class="success">Transaction analyzed and saved.</p><%}%><%if(request.getAttribute("error")!=null){%><p class="error"><%=request.getAttribute("error")%></p><%}%><div class="layout"><section class="card"><h2>Analyze transaction</h2><form method="post"><label>Customer ID</label><input name="customerId" required maxlength="80"><label>Amount (INR)</label><input name="amount" type="number" min=".01" step=".01" required><label>Payment method</label><select name="paymentMethod"><option>UPI</option><option>Credit Card</option><option>Debit Card</option><option>Net Banking</option><option>Unverified Wallet</option><option>Gift Card</option></select><label>Location</label><input name="location" required placeholder="Greater Noida or high-risk"><button>Analyze & Save</button></form><p class="muted">ML uses synthetic sample data for demonstration only.</p></section><section class="card"><h2>Transaction history and alerts</h2><div class="tablewrap"><table><tr><th>ID</th><th>Customer</th><th>Amount</th><th>Risk</th><th>Decision</th><th>Reason</th></tr><%for(Transaction t:tx){%><tr><td>#<%=t.id%></td><td><%=esc(t.customerId)%></td><td>₹<%=t.amount%></td><td><%=t.riskScore%>/100</td><td><span class="pill <%=t.decision%>"><%=t.decision%></span></td><td><%=esc(t.explanation)%></td></tr><%}%></table></div></section></div></main></body></html><%!private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>